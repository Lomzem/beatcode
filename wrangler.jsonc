{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "beatcode",
	"compatibility_date": "2026-10-22",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "beatcode.org", "custom_domain": true }],
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	}
}
