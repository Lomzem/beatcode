{
	"name": "beatcode",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.22.1 <25",
		"bun": "1.4.4"
	},
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0",
		"prepare": "svelte-kit sync && lefthook install",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun run test:backend && bun run test:judge && bun run test:ops && bun run test:calibration && bun run test:frontend && bun run test:browser && bun run test:auth && bun run test:game-ui && bun run test:primitives",
		"test:browser": "playwright test",
		"test:auth": "playwright test --config tests/auth-return/playwright.config.ts",
		"test:game-ui": "playwright test --config tests/game-ui/playwright.config.ts",
		"test:primitives": "svelte-check --tsconfig tests/ui-primitives/tsconfig.json && playwright test --config tests/ui-primitives/playwright.config.ts",
		"verify": "bun run check && bun run lint && bun run format:check && bun run build && bun run test",
		"test:backend": "vitest run --config vitest.config.ts tests/backend",
		"test:judge": "vitest run --config vitest.config.ts tests/judge",
		"test:ops": "vitest run --config vitest.config.ts tests/ops",
		"test:calibration": "vitest run --config tests/calibration/vitest.config.ts",
		"test:frontend": "vitest run --config tests/frontend/vitest.config.ts"
	},
	"dependencies": {
		"@clerk/clerk-js": "6.40.0",
		"@codemirror/autocomplete": "6.20.4",
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-cpp": "6.0.3",
		"@codemirror/language": "6.13.1",
		"@codemirror/lint": "6.9.7",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@lucide/svelte": "1.61.0",
		"bits-ui": "2.20.2",
		"clsx": "2.1.1",
		"codemirror": "6.0.2",
		"convex": "1.48.0",
		"convex-svelte": "0.15.1",
		"effect": "4.0.6",
		"modal": "0.11.1",
		"svelte": "5.57.2",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@shadcn/lint": "0.2.3",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.12.0",
		"convex-test": "0.0.64",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"lefthook": "2.2.2",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "1.7.0",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"wrangler": "4.152.0",
		"yaml": "1.10.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"trustedDependencies": [
		"esbuild",
		"lefthook",
		"@tailwindcss/oxide",
		"workerd",
		"sharp"
	]
}
